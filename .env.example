# EliGraph — variables d'environnement
# Copier ce fichier en .env et remplir les valeurs (jamais commité)

# --- Auth (obligatoire sauf USE_CLIENT_TOKEN) ---
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id

# --- Mode auth (choisir un seul) ---
# App-only avec secret
# CLIENT_SECRET=your-client-secret

# App-only avec certificat
# USE_CERTIFICATE=true
# CERTIFICATE_PATH=/app/certs/cert.pem
# CERTIFICATE_PASSWORD=

# Login navigateur interactif (dev local uniquement)
# USE_INTERACTIVE=true

# Token fourni par le client MCP (Claude.ai OBO flow)
# USE_CLIENT_TOKEN=true
# ACCESS_TOKEN=

# --- Redirect URI (interactive uniquement) ---
# REDIRECT_URI=http://localhost:3000

# --- Graph API ---
# USE_GRAPH_BETA=false   # Forcer v1.0 stable (défaut: beta autorisé)

# --- Serveur HTTP ---
PORT=3000

# --- Logging ---
# LOG_LEVEL=info
# LOG_FILE=/app/logs/eligraph.log

# --- Environnement ---
# ELIGRAPH_ENV=production
