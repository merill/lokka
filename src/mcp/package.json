{
  "name": "eligraph",
  "version": "1.0.0",
  "description": "EliGraph is a remote MCP server for Microsoft Graph and Azure RM APIs, with delegated auth, audit logging, and business rules.",
  "license": "MIT",
  "author": "Ishak CHENNOUF <chennoufishak@gmail.com>",
  "homepage": "https://github.com/Ishak-rav/EliGraph",
  "bugs": "https://github.com/Ishak-rav/EliGraph/issues",
  "main": "main.js",
  "type": "module",
  "keywords": [
    "mcp",
    "microsoft-graph",
    "azure",
    "entra",
    "m365",
    "model-context-protocol"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ishak-rav/EliGraph.git",
    "directory": "src/mcp"
  },
  "bin": {
    "eligraph": "build/main.js"
  },
  "scripts": {
    "build": "tsc --noCheck",
    "build:unix": "tsc --noCheck && chmod 755 build/main.js",
    "typecheck": "tsc --noEmit",
    "start": "node build/main.js",
    "start:http": "node build/server.js"
  },
  "files": [
    "build"
  ],
  "dependencies": {
    "@azure/identity": "^4.3.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/jsonwebtoken": "^9.0.10",
    "express": "^5.2.1",
    "isomorphic-fetch": "^3.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/isomorphic-fetch": "^0.0.39",
    "@types/node": "^22.13.17",
    "typescript": "^5.8.2"
  }
}
